# Development image: full deps + hot reload via tsx watch.
# Production uses Dockerfile (tsc build + node dist).
FROM node:22-alpine

WORKDIR /app

# Install dependencies (legacy-peer-deps: better-auth peerOptional vitest range,
# see UPGRADE_STRATEGY.md toolchain quirks)
COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

# Sync Prisma client with the schema at build time
# (re-run on schema changes: docker compose exec server npx prisma generate)
RUN npx prisma generate

EXPOSE 5000

# Deploy pending migrations, then start with hot reload.
# Source is bind-mounted by docker-compose for live editing.
CMD ["sh", "-c", "npx prisma migrate deploy && exec npx tsx watch src/index.ts"]
