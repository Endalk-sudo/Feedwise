PORT=5000
NODE_ENV=development

# PostgreSQL (Prisma) — docker-compose publishes the DB on host port 5434
DATABASE_URL="postgresql://postgres:feedback_dev@localhost:5434/feedback?schema=public"

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# AI (Vercel AI SDK + Google provider)
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Object storage (S3-compatible: AWS S3, MinIO, Cloudflare R2, ...)
# Bucket must allow public reads for logo hot-linking (or front it with S3_PUBLIC_URL).
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Base endpoint, e.g. https://s3.amazonaws.com, http://localhost:9000 (MinIO),
# or https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# MinIO-style providers need path style (true); AWS S3 wants false
S3_FORCE_PATH_STYLE=true
# Optional: CDN/custom-domain base for public logo URLs (must include the bucket path)
S3_PUBLIC_URL=
# Canned ACL for uploads; leave empty for providers without ACL support (R2)
S3_OBJECT_ACL=public-read

# URLs (client dev server)
CLIENT_URL=http://localhost:5173

# Redis / Upstash — powers BullMQ job queues + distributed rate limiting
# Local (docker compose): redis://localhost:6379  (or redis://redis:6379 inside compose)
# Upstash production: rediss://default:<password>@<id>.upstash.io:6379
# Leave empty to fall back to in-memory rate limits + node-cron only
REDIS_URL=redis://localhost:6379
