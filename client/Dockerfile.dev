# Development image: Vite dev server with hot reload.
# Production uses Dockerfile (vite build + nginx).
FROM node:22-alpine

WORKDIR /app

# Install dependencies (legacy-peer-deps, see UPGRADE_STRATEGY.md)
COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

EXPOSE 5173

# Source is bind-mounted by docker-compose for live editing.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
