# Development image: Vite dev server with hot reload.
# Build context is the REPO ROOT (see docker-compose.yml) so the
# "@aifc/contracts": "file:../shared" dependency resolves to /app/shared.
# Production uses client/Dockerfile (vite build + nginx).
FROM node:22-alpine

WORKDIR /app

# Copy client + shared manifests for dependency resolution
COPY client/package*.json client/
COPY shared/package*.json shared/

# Install shared package deps (needs zod + typescript to build)
WORKDIR /app/shared
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 180000 \
    && npm config set fetch-timeout 900000 \
    && npm ci --legacy-peer-deps

# Install client deps (file:../shared resolves to /app/shared)
# Retry + timeout config keeps npm ci alive on flaky networks
WORKDIR /app/client
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 180000 \
    && npm config set fetch-timeout 900000 \
    && npm ci --legacy-peer-deps

WORKDIR /app
COPY client ./client
COPY shared ./shared

# Build shared contracts (tsc -> dist/) so Vite can resolve @aifc/contracts
RUN npm --prefix shared run build

WORKDIR /app/client

EXPOSE 5173

# Source is bind-mounted by docker-compose for live editing (including
# ./shared -> /app/shared, which overlays the image-built dist/, hence the
# rebuild on start). The tsc --watch background job keeps dist/ fresh when
# shared/src changes. Vite is invoked directly (not `npm run dev`) so the
# predev contracts build doesn't run a second tsc concurrently with the
# watcher writing the same dist/ output.
CMD ["sh", "-c", "npm run build:contracts && (npm --prefix ../shared run dev &) && exec npx vite --host 0.0.0.0 --port 5173"]
